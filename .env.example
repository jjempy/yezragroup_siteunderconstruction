# ---- Supabase (new, separate project — do NOT reuse the Perennial project) ----
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_, never ship to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe ----
# Secret key — SERVER ONLY.
STRIPE_SECRET_KEY=
# Webhook signing secret from the Stripe Dashboard (or `stripe listen` locally) for the
# endpoint you point at /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# The Price ID (price_...) for the $147 Workshop Library one-time Payment Link.
# Used by the webhook to confirm which line item was purchased.
STRIPE_PRICE_WORKSHOP_LIBRARY=
